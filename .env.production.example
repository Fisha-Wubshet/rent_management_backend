APP_NAME=BookingSystem
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rent.gizebit.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_CPANEL_DB_NAME
DB_USERNAME=YOUR_CPANEL_DB_USERNAME
DB_PASSWORD=YOUR_CPANEL_DB_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log

JWT_SECRET=GENERATE_WITH_PHP_ARTISAN_JWT_SECRET

CORS_ALLOWED_ORIGINS=https://rent.gizebit.com
